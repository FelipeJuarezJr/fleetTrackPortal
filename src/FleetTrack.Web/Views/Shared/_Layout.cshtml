<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FleetTrack & Sales Portal</title>
    
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    
    <!-- FontAwesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    
    <!-- Enterprise Design System CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="enterprise-theme">
    <div class="app-layout">
        <!-- Sidebar Navigation -->
        <aside class="app-sidebar">
            <div class="sidebar-header">
                <div class="brand-logo">
                    <div class="logo-icon">
                        <i class="fa-solid fa-truck-moving"></i>
                    </div>
                    <div class="brand-text">
                        <span class="brand-name">FleetTrack</span>
                        <span class="brand-badge">Azure SQL</span>
                    </div>
                </div>
            </div>

            <div class="sidebar-user">
                <div class="user-avatar">
                    <i class="fa-solid fa-user-tie"></i>
                </div>
                <div class="user-info">
                    <span class="user-name">Solutions Architect</span>
                    <span class="user-role">Enterprise Admin</span>
                </div>
            </div>

            <nav class="sidebar-nav">
                <div class="nav-section-title">Operations</div>
                <a href="/" class="nav-item active" id="nav-inventory">
                    <i class="fa-solid fa-table-columns"></i>
                    <span>Fleet Inventory</span>
                    <span class="nav-counter" id="sidebar-active-counter">...</span>
                </a>
                <a href="#sales-section" class="nav-item" id="nav-sales">
                    <i class="fa-solid fa-file-invoice-dollar"></i>
                    <span>Sales Orders</span>
                </a>
                
                <div class="nav-section-title">Architecture & Cloud</div>
                <a href="#azure-telemetry" class="nav-item" id="nav-telemetry" onclick="FleetPortal.showTelemetryModal(); return false;">
                    <i class="fa-solid fa-chart-line"></i>
                    <span>App Insights</span>
                    <span class="status-dot-live"></span>
                </a>
                <a href="#db-schema" class="nav-item" id="nav-schema" onclick="FleetPortal.showArchitectureModal(); return false;">
                    <i class="fa-solid fa-database"></i>
                    <span>Database T-SQL</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                <div class="cloud-status-card">
                    <div class="cloud-status-header">
                        <span class="cloud-provider"><i class="fa-brands fa-microsoft"></i> Azure Ready</span>
                        <span class="pulse-indicator"></span>
                    </div>
                    <div class="cloud-meta">
                        <div><small>Engine:</small> <span>.NET 8 WebAPI</span></div>
                        <div><small>DB Mode:</small> <span>Stored Procs / Dapper</span></div>
                    </div>
                </div>
            </div>
        </aside>

        <!-- Main Content Area -->
        <div class="app-main">
            <!-- Top App Bar -->
            <header class="app-header">
                <div class="header-left">
                    <button class="mobile-toggle" id="btn-toggle-sidebar" aria-label="Toggle Navigation">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <div class="breadcrumb">
                        <span class="breadcrumb-root">Fleet Operations</span>
                        <i class="fa-solid fa-chevron-right breadcrumb-separator"></i>
                        <span class="breadcrumb-current">Inventory & Sales Portal</span>
                    </div>
                </div>

                <div class="header-right">
                    <!-- Environment Tag -->
                    <div class="env-pill">
                        <i class="fa-solid fa-cloud"></i>
                        <span>Azure App Service</span>
                    </div>

                    <!-- Live DB Indicator -->
                    <div class="db-indicator" title="Connected to Azure SQL Database">
                        <span class="db-ping-dot"></span>
                        <span class="db-text">Azure SQL (1433)</span>
                    </div>

                    <!-- App Insights Indicator -->
                    <button class="header-btn" title="View Application Insights Telemetry" onclick="FleetPortal.showTelemetryModal()">
                        <i class="fa-solid fa-satellite-dish"></i>
                        <span class="btn-label">Telemetry</span>
                    </button>
                </div>
            </header>

            <!-- Main Page View Content -->
            <main class="page-container">
                @RenderBody()
            </main>

            <!-- Global Footer -->
            <footer class="app-footer">
                <div class="footer-left">
                    <span>FleetTrack Enterprise Solutions Portal &copy; @DateTime.UtcNow.Year. High-Concurrency Proof-of-Concept.</span>
                </div>
                <div class="footer-right">
                    <span>Architecture: ASP.NET Core MVC + WebAPI + Dapper T-SQL + jQuery 3.x</span>
                </div>
            </footer>
        </div>
    </div>

    <!-- Global Toast Notification Container -->
    <div id="toast-container" class="toast-container" aria-live="polite"></div>

    <!-- Core Scripts: jQuery 3.7.1 and Fleet Portal App Logic -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <script src="~/js/fleet-portal.js" asp-append-version="true"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
